# ==============================================================================
# Therapinc Marketing Website - Environment Variables Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# Resend API Configuration (Form Submissions)
# Get your API key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Email address to receive contact form notifications
CONTACT_NOTIFICATION_EMAIL=contact@therapinc.com

# Sender email address verified in Resend (e.g., website@therapinc.com)
SENDER_EMAIL=website@therapinc.com

# Site Metadata & Domain
NEXT_PUBLIC_SITE_URL=https://therapinc.com

# Analytics (Optional / Vercel native)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
